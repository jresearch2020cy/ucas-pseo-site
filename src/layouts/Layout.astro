---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Explore official UK university admissions statistics, applicant competition ratios, historical trends (2019-2025), and LEO graduate career salaries.",
  canonical
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://unistats.pages.dev";
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['Inter', 'sans-serif'] },
            colors: {
              brand: { 50: '#f0f7ff', 100: '#e0effe', 600: '#2563eb', 700: '#1d4ed8', 900: '#1e3a8a' }
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col justify-between">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-xl font-extrabold text-brand-700 tracking-tight flex items-center gap-2">
          <span>📊</span> UniStats UK
        </a>
        
        <div class="relative w-64 md:w-80">
          <a href="/universities/" class="text-xs font-semibold text-gray-600 hover:text-brand-600 bg-gray-100 px-3 py-2 rounded-lg border border-gray-200 block text-center">
            🔍 Search Directory
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="bg-white border-t border-gray-200 py-8 mt-16 text-center text-xs text-gray-500">
      <div class="max-w-6xl mx-auto px-4">
        <p class="mb-2">© {new Date().getFullYear()} UniStats UK. Data sourced from official UCAS Main Scheme Admissions & DfE Longitudinal Education Outcomes (LEO).</p>
        <div class="space-x-4">
          <a href="/universities/" class="hover:underline">Universities Index</a>
          <a href="/subjects/" class="hover:underline">Subjects Index</a>
        </div>
      </div>
    </footer>
  </body>
</html>
